[Unit]
Description=BusBoard: reset the admin password (requested from the boot partition)
# Create an empty file "busboard-reset-password" on the SD card's boot
# partition to get a new admin password shown on the board.
ConditionPathExists=/boot/firmware/busboard-reset-password
After=local-fs.target
Before=busboard-web.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/busboard-reset-password

[Install]
WantedBy=multi-user.target
